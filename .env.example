# Supabase — public anon key (safe to expose to the client)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat — public API key for iOS
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_key_here

# Sentry — DSN (public, used client-side for error reporting)
EXPO_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# App deep link domain (for Universal Links)
EXPO_PUBLIC_APP_DOMAIN=syncup.app

# --- SERVER-SIDE ONLY (Edge Functions / CI) — NEVER expose to client ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET=your-jwt-secret
# REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# --- MIGRATIONS / LOCAL TOOLING ONLY --- NEVER expose to client, never commit ---
# Get from: Supabase Dashboard → Settings → Database → Connection String → URI
# DATABASE_URL=postgresql://postgres:[DB_PASSWORD]@db.ilykfwtiebfyaljlhsrx.supabase.co:5432/postgres
