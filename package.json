{
  "name": "syncup",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@supabase/supabase-js": "^2.106.1",
    "expo": "~56.0.4",
    "expo-apple-authentication": "^56.0.4",
    "expo-router": "^56.2.6",
    "expo-secure-store": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-hook-form": "^7.76.1",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^56.0.12",
    "detox": "^20.50.4",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.js --passWithNoTests",
    "test:security": "jest --testPathPattern='__tests__/security/' --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write '**/*.{ts,tsx,js,json}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,json}'",
    "prepare": "husky",
    "test:e2e:ios:debug": "detox test --configuration ios.sim.debug",
    "test:e2e:ios:release": "detox test --configuration ios.sim.release",
    "build:e2e:ios": "detox build --configuration ios.sim.debug",
    "secret-scan": "git ls-files | grep -v 'package.json\\|package-lock.json' | xargs grep -lE 'SUPABASE_SERVICE_ROLE_KEY\\s*=\\s*ey|sk_live_[A-Za-z0-9]|sk_test_[A-Za-z0-9]' 2>/dev/null && echo 'SECRETS FOUND' || echo 'No secrets found in tracked files'"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "private": true
}
